# ============================================================
# iDevice Store — environment variables
# Copy to .env (local) or set in your hosting dashboard (production).
# NEVER commit real values. Every secret below is a placeholder.
# ============================================================

# --- Core -----------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STORE_NAME="iDevice Store"
STORE_CURRENCY=UAH
DEFAULT_LOCALE=uk

# --- Database (PostgreSQL) ------------------------------------
DATABASE_URL="postgresql://idevice:idevice@localhost:5432/idevice?schema=public"

# --- Auth.js --------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Required behind a proxy / on custom domains
AUTH_TRUST_HOST=true
# If "true", customers must verify e-mail before they can sign in
REQUIRE_EMAIL_VERIFICATION=true

# --- Data encryption (IMEI / serial numbers at rest) ----------
# Generate: openssl rand -hex 32   (64 hex chars = 32 bytes)
DATA_ENCRYPTION_KEY=

# --- LiqPay ---------------------------------------------------
# Business cabinet: https://www.liqpay.ua/uk/adminbusiness  (see docs/LIQPAY.md)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Server->server callback (must be a public HTTPS URL)
LIQPAY_CALLBACK_URL=http://localhost:3000/api/payments/liqpay/callback
# Where the customer returns after paying (never proves payment!)
LIQPAY_RESULT_URL=http://localhost:3000/checkout/result
# Accept LiqPay "sandbox" (test) payments as paid. MUST be false in production.
LIQPAY_ALLOW_SANDBOX=true

# --- Nova Poshta ----------------------------------------------
# Personal cabinet -> Settings -> Security -> API keys (see docs/NOVA_POSHTA.md)
NOVA_POSHTA_API_KEY=
# Sender data (obtained once via the API; see docs/NOVA_POSHTA.md)
NOVA_POSHTA_SENDER_REF=
NOVA_POSHTA_SENDER_CONTACT_REF=
NOVA_POSHTA_SENDER_CITY_REF=
NOVA_POSHTA_SENDER_WAREHOUSE_REF=
NOVA_POSHTA_SENDER_PHONE=

# --- E-mail (choose one provider) -----------------------------
# EMAIL_PROVIDER: resend | smtp | console
EMAIL_PROVIDER=console
EMAIL_FROM="iDevice Store <no-reply@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# --- Image storage (Cloudinary) -------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Analytics ------------------------------------------------
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
META_PIXEL_ID=




# --- Rate limiting (optional; falls back to in-memory) --------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (Vercel cron / external scheduler) ------------------
# Generate: openssl rand -hex 24
CRON_SECRET=

# --- Seed (initial admin) -------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
